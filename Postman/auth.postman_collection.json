  "item": [
    {
      "name": "员工自助注册",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workId\": \"{{work_id}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"passwordAgain\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
              "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
