{
  "info": {
    "_postman_id": "3f9e2c6d-8b41-4f5a-9d6e-1c8a2e5b7f4d",
    "name": "Auth API",
    "description": "JWT authentication endpoints. Run in order: register first (binds the seeded employee record), then login stores tokens as collection variables, then me/refresh/verify use them.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5074",
      "type": "string",
      "disabled": false
    },
    {
      "key": "work_id",
      "value": "A001",
      "type": "string",
      "disabled": false
    },
    {
      "key": "username",
      "value": "testuser",
      "type": "string",
      "disabled": false
    },
    {
      "key": "password",
      "value": "password123",
      "type": "string",
      "disabled": false
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string",
      "disabled": false
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string",
      "disabled": false
    }
  ],
  "item": [
    {
      "name": "员工自助注册",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"workId\": \"{{work_id}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"passwordAgain\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
              "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "获取当前用户信息",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/me",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "me"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "none"
        }
      },
      "response": []
    },
    {
      "name": "刷新令牌",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/refresh",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
              "pm.collectionVariables.set(\"refresh_token\", jsonData.refreshToken);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "验证令牌",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/verify",
          "protocol": "http",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "verify"
          ],
          "port": "",
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{access_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}
